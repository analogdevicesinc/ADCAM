--- a/drivers/media/i2c/Makefile
+++ b/drivers/media/i2c/Makefile
@@ -41,3 +41,5 @@ obj-m += pca9570.o
 obj-m += virtual_i2c_mux.o
 endif
 endif
+
+obj-y += SG_MIPI_CAM/
diff --git a/drivers/media/i2c/SG_MIPI_CAM/Makefile b/drivers/media/i2c/SG_MIPI_CAM/Makefile
new file mode 100644
index 00000000..4ec9ede2
--- /dev/null
+++ b/drivers/media/i2c/SG_MIPI_CAM/Makefile
@@ -0,0 +1,6 @@
+subdir-ccflags-y += -Werror
+
+ccflags-y += -I$(srctree)/drivers/media/platform/tegra
+ccflags-y += -I$(srctree)/drivers/video/tegra/camera
+
+obj-m += sg2-mipi-ar0234-5200.o
\ No newline at end of file
diff --git a/drivers/media/i2c/SG_MIPI_CAM/sg2-mipi-ar0234-5200-tbls.h b/drivers/media/i2c/SG_MIPI_CAM/sg2-mipi-ar0234-5200-tbls.h
new file mode 100644
index 00000000..e92c8331
--- /dev/null
+++ b/drivers/media/i2c/SG_MIPI_CAM/sg2-mipi-ar0234-5200-tbls.h
@@ -0,0 +1,66 @@
